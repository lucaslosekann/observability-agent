# Identidade estavel desta instalacao. Use somente [a-z0-9-].
INSTALLATION_ID=porto-itajai-prod
# Nome legivel do cliente, usado nos filtros do Grafana.
CUSTOMER_NAME=Porto Itajai
# Ambiente logico: production, staging, development etc.
ENVIRONMENT=production
# Identificador estavel deste host dentro da instalacao.
HOST_ID=novvs-prod-01
# Versao da aplicacao Novvs. Pode ficar vazia quando desconhecida.
APPLICATION_VERSION=

# URL publica da central, sem barra final. Em producao use HTTPS.
CENTRAL_BASE_URL=http://host.docker.internal
# Credencial de ingestao exclusiva desta instalacao.
OBSERVABILITY_USERNAME=porto-itajai-prod
OBSERVABILITY_PASSWORD=change-me
# Use false somente em desenvolvimento com certificado nao confiavel.
TLS_VERIFY_CERTIFICATE=true
TLS_VERIFY_HOSTNAME=true

# Diretorio do host onde o Novvs grava os JSONL/NDJSON.
NOVVS_LOG_DIR=/opt/novvs/logs
# Glob relativo ao diretorio acima. Nao use caminho absoluto.
NOVVS_LOG_GLOB=*.jsonl
# Limite em bytes do buffer persistente do Vector (minimo: 268435488).
VECTOR_BUFFER_MAX_BYTES=1073741824

# Conexao PostgreSQL. host.docker.internal funciona no Docker Linux por
# causa do mapeamento host-gateway presente no compose.yaml.
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DATABASE=novvs
POSTGRES_USER=novvs_observability
POSTGRES_PASSWORD=change-me
# Valores usuais: disable, require, verify-ca ou verify-full.
POSTGRES_SSLMODE=disable

